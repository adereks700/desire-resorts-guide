<section class="services-container page">
  <h1>Services</h1>
  <p>A few of the extras worth knowing about before you go, some included, some worth booking ahead.</p>

  <nav class="services-jump">
    <a href="#spa">Spa</a>
    <a href="#gym">Gym & Activities</a>
